\n# Firebase Admin (Google login, Firestore member storage, FCM push)\nFIREBASE_SERVICE_ACCOUNT_FILE=./firebase-service-account.json\n# Or provide the complete service-account JSON as one environment variable:\n# FIREBASE_SERVICE_ACCOUNT_JSON={...}\n